NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Optional: same-origin proxy for networks that block *.supabase.co ---
# Set these on Vercel to route Supabase Auth and the backend API through the
# app's own domain (via next.config.ts rewrites), so ISPs/firewalls that
# allow the site itself but block supabase.co no longer break login.
# SUPABASE_ORIGIN=https://xxxx.supabase.co                 (server-only, no NEXT_PUBLIC_ prefix)
# API_ORIGIN=https://your-backend-host                     (server-only, no NEXT_PUBLIC_ prefix)
# NEXT_PUBLIC_SUPABASE_BROWSER_URL=https://your-app.vercel.app/sb
# NEXT_PUBLIC_API_URL=/api